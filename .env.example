# ================================================================
# AI-103 PROJECT 29: AI Multi-Agent Business Operations Assistant
# Environment Configuration
# ================================================================

# Mode: 'local' (offline demo mode, no credit consumption) or 'azure' (Microsoft Foundry / Azure OpenAI)
EXECUTION_MODE=local

# Application Ports
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=8501

# Microsoft Foundry / Azure OpenAI Settings (Used when EXECUTION_MODE=azure)
# Get these from Azure Foundry Portal -> Project Overview & Deployments
PROJECT_ENDPOINT=https://your-foundry-resource.services.ai.azure.com/api/projects/business-assistant
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your_api_key_if_not_using_entra_id
MODEL_DEPLOYMENT_NAME=gpt-4o-mini-business
OPENAI_API_VERSION=2024-08-01-preview

# Security & Governance
HUMAN_APPROVAL_THRESHOLD_USD=500.00
MAX_DISCOUNT_PERCENT=15.0
AUTO_REFUND_ALLOWED=false
